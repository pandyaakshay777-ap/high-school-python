    "# Practical 5\n",
    "\n",
    "- WAP to find the largest and smallest number in an array."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e0d7343e-56ba-4331-911b-1cbba407953a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The largest number is 89\n",
      "The smallest numner is 12\n"
     ]
    }
   ],
   "source": [
    "array = [12, 25, 45, 67, 23, 89]\n",
    "largest_num = max(array)\n",
    "smallest_num = min(array)\n",
    "print(\"The largest number is\", largest_num)\n",
    "print(\"The smallest numner is\",  smallest_num)"
   ]
  }
