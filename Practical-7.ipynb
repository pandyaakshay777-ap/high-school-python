   "source": [
    "# Practical 7\n",
    "\n",
    "- WAP to count the total number of elements in a list."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "b8f5e7eb-4309-4ca8-a567-1d56d007fc8a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The given list is ['apple', 'banana', 'cherry', 'grapes']\n",
      "The total number of elements is 4\n"
     ]
    }
   ],
   "source": [
    "fruits = [\"apple\", \"banana\", \"cherry\", \"grapes\"]\n",
    "print(\"The given list is\", fruits)\n",
    "count = 0\n",
    "for i in fruits:\n",
    "    count += 1\n",
    "print(\"The total number of elements is\", count)"
   ]
  }
