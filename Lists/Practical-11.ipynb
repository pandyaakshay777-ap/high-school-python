   "source": [
    "fruits = [\"apple\", \"grapes\", \"banana\", \"orange\", \"cherry\"]\n",
    "print(fruits)\n",
    "index = int(input(\"Enter the index of required element:\"))\n",
    "print(fruits[index])"
   ]
